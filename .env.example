# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values.
# Get these from Firebase Console → Project Settings → Your Apps → Web App Config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ADMIN SETUP INSTRUCTIONS:
# 1. Go to Firebase Console → Authentication → Add User
# 2. Create admin email/password manually (e.g., admin@homemate.com)
# 3. Copy the UID of the created admin user
# 4. Go to Firestore → users collection → Add Document
# 5. Use the admin UID as the document ID
# 6. Add fields: { uid, name, email, role: "admin", createdAt }
# 7. Admin can then login at /admin-login
